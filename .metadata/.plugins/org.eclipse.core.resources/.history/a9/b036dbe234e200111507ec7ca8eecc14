package com.krakedev;

public class Fecha {
	
	private int dia;
	private int mes;
	private int anio;
	
	public int getDia() {
		return dia;
	}
	
	public int getMes() {
		return mes;
	}
	
	public int getAnio() {
		return anio;
	}
	
	public void setDia(int Dia) {
		this.dia = Dia;
	}
	
	public void setMes(int Mes) {
		this.mes = Mes;
	}
	
	public void setAnio(int Anio) {
		this.anio = Anio;
	}
}
